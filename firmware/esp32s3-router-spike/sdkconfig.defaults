CONFIG_TINYUSB_HID_COUNT=1
CONFIG_TINYUSB_NET_MODE_NONE=y
# CONFIG_TINYUSB_NET_MODE_NCM is not set
# CONFIG_TINYUSB_NET_MODE_ECM_RNDIS is not set
CONFIG_TINYUSB_DESC_USE_DEFAULT_PID=n
CONFIG_TINYUSB_DESC_USE_ESPRESSIF_VID=y
CONFIG_TINYUSB_DESC_MANUFACTURER_STRING="BOOTMUX"
CONFIG_TINYUSB_DESC_PRODUCT_STRING="BOOTMUX Keyboard Safe"
CONFIG_TINYUSB_DESC_SERIAL_STRING="BOOTMUX-HID-SAFE"
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
# USB Network disabled by default - serial only
CONFIG_BOOTMUX_USB_NETWORK_EXPERIMENTAL=n
# CONFIG_LWIP_IP_FORWARD is not set
# CONFIG_LWIP_IPV4_NAPT is not set
