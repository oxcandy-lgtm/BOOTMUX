# ============================================================================
# DEPRECATED: USB Network Experimental Configuration
# This file is kept for historical reference only.
# USB network is DISABLED by default. See USB_NETWORK_DEPRECATED.md
# ============================================================================

CONFIG_TINYUSB_HID_COUNT=1
# CONFIG_TINYUSB_NET_MODE_NONE is not set
CONFIG_TINYUSB_NET_MODE_NCM=y
CONFIG_TINYUSB_NET_MODE_ECM_RNDIS=n
CONFIG_TINYUSB_DESC_USE_DEFAULT_PID=n
CONFIG_TINYUSB_DESC_USE_ESPRESSIF_VID=y
CONFIG_TINYUSB_DESC_MANUFACTURER_STRING="BOOTMUX"
CONFIG_TINYUSB_DESC_PRODUCT_STRING="BOOTMUX Bridge Experimental"
CONFIG_TINYUSB_DESC_SERIAL_STRING="BOOTMUX-R7A-NCM"
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BOOTMUX_USB_NETWORK_EXPERIMENTAL=y
CONFIG_LWIP_IP_FORWARD=y
CONFIG_LWIP_IPV4_NAPT=y
